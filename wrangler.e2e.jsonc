{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "llm-chat-app-template-e2e",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"binding": "ASSETS",
		"directory": "./public"
	},
	"observability": {
		"enabled": true
	},
	// The AI binding is required here: without it env.AI is undefined and any
	// request to /api/chat or /v1/chat/completions would throw.
	"ai": {
		"binding": "AI"
	}
}
